<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodServiceApp.Maui.Views.VendorRegisterPage"
             Title="Đăng ký gian hàng">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Đăng ký tham gia nền tảng" Style="{StaticResource TitleLabel}" />
            <Label Text="Điền thông tin cửa hàng để trở thành đối tác. Hồ sơ sẽ được quản trị viên duyệt trước khi kích hoạt."
                   Style="{StaticResource SubtitleLabel}" Margin="0,0,0,8" />

            <Label Text="Tên gian hàng *" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntryTenGianHang" Placeholder="VD: Bún Riêu Cô Tư" />

            <Label Text="Địa chỉ cửa hàng *" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntryDiaChi" Placeholder="Số nhà, đường, quận..." />

            <Label Text="Số điện thoại *" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntrySdt" Placeholder="09xxxxxxxx" Keyboard="Telephone" />

            <Label Text="Email *" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntryEmail" Placeholder="email@gianhang.vn" Keyboard="Email" />

            <Label Text="Mật khẩu *" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntryMatKhau" Placeholder="Tối thiểu 6 ký tự" IsPassword="True" />

            <Label Text="Mô tả ngắn về gian hàng" FontSize="13" FontAttributes="Bold" />
            <Editor x:Name="EditorMoTa" Placeholder="Món chủ lực, giờ mở cửa, đặc điểm nổi bật..."
                    HeightRequest="80" BackgroundColor="White" />

            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False"
                                Color="{StaticResource Primary}" />

            <Button x:Name="BtnGuiDangKy" Text="Gửi đăng ký" Style="{StaticResource PrimaryButton}"
                    Margin="0,10,0,0" Clicked="OnGuiDangKyClicked" />

            <Label x:Name="LblLoi" TextColor="{StaticResource Danger}" FontSize="12"
                   HorizontalOptions="Center" IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
