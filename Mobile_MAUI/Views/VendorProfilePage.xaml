<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodServiceApp.Maui.Views.VendorProfilePage"
             Title="Hồ sơ cửa hàng">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Frame WidthRequest="72" HeightRequest="72" CornerRadius="18"
                   BackgroundColor="{StaticResource Primary}"
                   HorizontalOptions="Center" Padding="0">
                <Label x:Name="LblAnhHienTai" FontSize="34" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>

            <Label Text="Biểu tượng cửa hàng (emoji)" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntryHinhAnh" Placeholder="🍚" MaxLength="4" />

            <Label Text="Tên gian hàng *" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntryTenGianHang" />

            <Label Text="Địa chỉ *" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntryDiaChi" />

            <Label Text="Số điện thoại *" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntrySdt" Keyboard="Telephone" />

            <Label Text="Email" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntryEmail" Keyboard="Email" IsEnabled="False" TextColor="{StaticResource TextGrey}" />

            <Label Text="Thời gian giao hàng dự kiến (phút)" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntryThoiGianGiao" Keyboard="Numeric" />

            <Label Text="Mô tả cửa hàng" FontSize="13" FontAttributes="Bold" />
            <Editor x:Name="EditorMoTa" HeightRequest="90" BackgroundColor="White" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                <Label Grid.Column="0" Text="Đang mở bán" FontSize="13" VerticalOptions="Center" />
                <Switch Grid.Column="1" x:Name="SwitchDangMoCua" OnColor="{StaticResource Primary}" />
            </Grid>

            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False"
                                Color="{StaticResource Primary}" />

            <Button x:Name="BtnLuu" Text="Lưu thay đổi" Style="{StaticResource PrimaryButton}"
                    Margin="0,10,0,0" Clicked="OnLuuClicked" />

            <Label x:Name="LblLoi" TextColor="{StaticResource Danger}" FontSize="12"
                   HorizontalOptions="Center" IsVisible="False" />

            <Label x:Name="LblThanhCong" TextColor="{StaticResource Success}" FontSize="12"
                   HorizontalOptions="Center" IsVisible="False" Text="✔ Đã lưu thay đổi" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
