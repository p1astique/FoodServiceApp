<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodServiceApp.Maui.Views.VendorMenuItemEditPage"
             Title="Thêm món ăn">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Đường dẫn ảnh món" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntryHinhAnh" Placeholder="https://... hoặc /uploads/..." MaxLength="255" />

            <Label Text="Tên món *" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntryTenMon" Placeholder="VD: Cơm tấm sườn bì chả" />

            <Label Text="Danh mục *" FontSize="13" FontAttributes="Bold" />
            <Picker x:Name="PickerDanhMuc" Title="Chọn danh mục">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Món chính</x:String>
                        <x:String>Món phụ</x:String>
                        <x:String>Nước uống</x:String>
                        <x:String>Tráng miệng</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label Text="Giá bán (đ) *" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntryGia" Placeholder="VD: 45000" Keyboard="Numeric" />

            <Label Text="Mô tả món" FontSize="13" FontAttributes="Bold" />
            <Editor x:Name="EntryMoTa" Placeholder="Mô tả ngắn về món" AutoSize="TextChanges" />

            <Label Text="Kích cỡ" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntryKichCo" Placeholder="Nhỏ, Vừa, Lớn" />
            <Label Text="Topping" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntryTopping" Placeholder="Trứng, Phô mai, Trân châu" />
            <Label Text="Mức cay" FontSize="13" FontAttributes="Bold" />
            <Entry x:Name="EntryMucCay" Placeholder="Không cay, Cay vừa, Cay nhiều" />
            <Label Text="Các lựa chọn phân cách bằng dấu phẩy." FontSize="11" TextColor="{StaticResource TextGrey}" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                <Label Grid.Column="0" Text="Còn hàng (đang mở bán món này)" FontSize="13" VerticalOptions="Center" />
                <Switch Grid.Column="1" x:Name="SwitchConHang" IsToggled="True" OnColor="{StaticResource Primary}" />
            </Grid>

            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False"
                                Color="{StaticResource Primary}" />

            <Button x:Name="BtnLuu" Text="Lưu món ăn" Style="{StaticResource PrimaryButton}"
                    Margin="0,10,0,0" Clicked="OnLuuClicked" />

            <Button x:Name="BtnXoa" Text="Xóa món ăn này" IsVisible="False"
                    BackgroundColor="Transparent" TextColor="{StaticResource Danger}"
                    BorderColor="{StaticResource Danger}" BorderWidth="1" CornerRadius="12" HeightRequest="46"
                    Clicked="OnXoaClicked" />

            <Label x:Name="LblLoi" TextColor="{StaticResource Danger}" FontSize="12"
                   HorizontalOptions="Center" IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
