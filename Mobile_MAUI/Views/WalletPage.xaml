<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodServiceApp.Maui.Views.WalletPage"
             Title="Ví tiền" Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <Label Text="Ví tiền" Style="{StaticResource TitleLabel}" />

            <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="18" HasShadow="False" Padding="20">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Số dư khả dụng" TextColor="#B3FFFFFF" FontSize="12.5" />
                    <Label Text="235.000đ" TextColor="White" FontSize="26" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                        <Button Grid.Column="0" Text="+ Nạp tiền" BackgroundColor="Transparent"
                                TextColor="White" BorderColor="#80FFFFFF" BorderWidth="1" CornerRadius="8" />
                        <Button Grid.Column="1" Text="Liên kết thẻ" BackgroundColor="Transparent"
                                TextColor="White" BorderColor="#80FFFFFF" BorderWidth="1" CornerRadius="8" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Label Text="Lịch sử giao dịch" FontAttributes="Bold" FontSize="14" Margin="0,6,0,0" />

            <Frame Style="{StaticResource CardFrame}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Label Grid.Column="0" Text="⬆" TextColor="{StaticResource Danger}" FontSize="16" />
                    <Label Grid.Column="1" Text="Thanh toán đơn #DH1029" FontSize="12.5" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="-105.000đ" FontSize="12.5" FontAttributes="Bold" VerticalOptions="Center" />
                </Grid>
            </Frame>
            <Frame Style="{StaticResource CardFrame}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Label Grid.Column="0" Text="⬇" TextColor="{StaticResource Success}" FontSize="16" />
                    <Label Grid.Column="1" Text="Nạp tiền từ Vietcombank" FontSize="12.5" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="+300.000đ" FontSize="12.5" FontAttributes="Bold"
                           TextColor="{StaticResource Success}" VerticalOptions="Center" />
                </Grid>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
