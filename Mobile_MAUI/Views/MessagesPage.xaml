<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodServiceApp.Maui.Views.MessagesPage"
             Title="Tin nhắn" Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label Text="Tin nhắn" Style="{StaticResource TitleLabel}" />

            <Frame Style="{StaticResource CardFrame}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Label Grid.Column="0" Text="🍚" FontSize="20" />
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Cơm Tấm Sài Gòn" FontAttributes="Bold" FontSize="13.5" />
                        <Label Text="Dạ shop đã nhận đơn, chuẩn bị 15 phút" FontSize="11.5" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Frame Grid.Column="2" BackgroundColor="{StaticResource Accent}" CornerRadius="8"
                           Padding="6,2" HasShadow="False" VerticalOptions="Center">
                        <Label Text="2" TextColor="White" FontSize="10.5" />
                    </Frame>
                </Grid>
            </Frame>

            <Frame Style="{StaticResource CardFrame}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Label Grid.Column="0" Text="🛵" FontSize="20" />
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Shipper Minh Tuấn" FontAttributes="Bold" FontSize="13.5" />
                        <Label Text="Mình đang ở gần khu vực bạn rồi nha" FontSize="11.5" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Frame Grid.Column="2" BackgroundColor="{StaticResource Accent}" CornerRadius="8"
                           Padding="6,2" HasShadow="False" VerticalOptions="Center">
                        <Label Text="1" TextColor="White" FontSize="10.5" />
                    </Frame>
                </Grid>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
