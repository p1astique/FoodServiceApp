<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodServiceApp.Maui.Views.ProfilePage"
             Title="Tài khoản">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Frame WidthRequest="72" HeightRequest="72" CornerRadius="36"
                   BackgroundColor="{StaticResource PrimaryLight}" HorizontalOptions="Center" Padding="0">
                <Label Text="👤" FontSize="32" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>
            <Label Text="Nguyễn Văn A" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" />
            <Label Text="nguyenvana@email.com" TextColor="{StaticResource TextGrey}" FontSize="12.5" HorizontalOptions="Center" Margin="0,0,0,10" />

            <Frame Style="{StaticResource CardFrame}"><Label Text="📍  Địa chỉ giao hàng" FontSize="13" /></Frame>
            <Frame Style="{StaticResource CardFrame}"><Label Text="💳  Phương thức thanh toán" FontSize="13" /></Frame>
            <Frame Style="{StaticResource CardFrame}"><Label Text="🏷️  Ưu đãi của tôi" FontSize="13" /></Frame>
            <Frame Style="{StaticResource CardFrame}"><Label Text="⚙️  Cài đặt" FontSize="13" /></Frame>
            <Frame Style="{StaticResource CardFrame}" BorderColor="{StaticResource Danger}">
                <Label Text="🚪  Đăng xuất" FontSize="13" TextColor="{StaticResource Danger}" />
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
