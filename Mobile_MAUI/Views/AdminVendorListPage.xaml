<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:FoodServiceApp.Maui.Services"
             x:Class="FoodServiceApp.Maui.Views.AdminVendorListPage"
             Title="Danh sách gian hàng">
    <RefreshView x:Name="RefreshDsGianHang" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="10">
                <CollectionView x:Name="DsGianHang" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="services:AdminVendorDto">
                            <Frame Style="{StaticResource CardFrame}" Margin="0,0,0,10">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding TenCuaHang}" FontAttributes="Bold" FontSize="14" />
                                            <Label FontSize="11" TextColor="{StaticResource TextGrey}"
                                                   Text="{Binding NgayDangKy, StringFormat='Tham gia từ {0:dd/MM/yyyy}'}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding TrangThaiKinhDoanh}" FontSize="11" FontAttributes="Bold" />
                                    </Grid>
                                    <Label Text="{Binding DiaChi}" FontSize="12.5" TextColor="{StaticResource TextGrey}" />
                                    <Label Text="{Binding SDT, StringFormat='📞 {0}'}" FontSize="12.5" />
                                    <Label Text="{Binding Email, StringFormat='✉️ {0}'}" FontSize="12.5" />
                                    <Button Text="Khóa / mở khóa tài khoản" HeightRequest="38" FontSize="13" CornerRadius="10"
                                            BackgroundColor="Transparent" BorderWidth="1"
                                            Clicked="OnKhoaMoClicked" CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>