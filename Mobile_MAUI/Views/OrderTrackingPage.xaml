<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodServiceApp.Maui.Models"
             x:Class="FoodServiceApp.Maui.Views.OrderTrackingPage"
             Title="Đơn hàng"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <Label Text="Đơn hàng của tôi" Style="{StaticResource TitleLabel}" />

            <!-- Đơn đang xử lý: thanh tiến trình 4 bước -->
            <Frame x:Name="KhungDangGiao" BackgroundColor="{StaticResource Primary}" CornerRadius="18" IsVisible="False">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" x:Name="LblMaDonDangGiao" TextColor="White" FontAttributes="Bold" FontSize="14" />
                        <Frame Grid.Column="1" BackgroundColor="{StaticResource Accent}" CornerRadius="12" Padding="10,4" HasShadow="False">
                            <Label x:Name="LblTrangThaiDangGiao" TextColor="White" FontSize="11" />
                        </Frame>
                    </Grid>
                    <Label x:Name="LblGianHangDangGiao" TextColor="#B3FFFFFF" FontSize="12.5" />

                    <Grid x:Name="ThanhTienTrinh" ColumnDefinitions="*,*,*,*" HeightRequest="6" Margin="0,8">
                        <BoxView Grid.Column="0" x:Name="Buoc0" CornerRadius="3" />
                        <BoxView Grid.Column="1" x:Name="Buoc1" CornerRadius="3" />
                        <BoxView Grid.Column="2" x:Name="Buoc2" CornerRadius="3" />
                        <BoxView Grid.Column="3" x:Name="Buoc3" CornerRadius="3" />
                    </Grid>

                    <Frame BackgroundColor="#1EFFFFFF" CornerRadius="12" HasShadow="False" Padding="10">
                        <Label Text="🛵  Shipper đang trên đường giao đến bạn" TextColor="White" FontSize="12" />
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <Label Text="Lịch sử đơn hàng" FontAttributes="Bold" FontSize="14" Margin="0,8,0,0" />

            <CollectionView x:Name="DsLichSu" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DonHang">
                        <Frame Style="{StaticResource CardFrame}" Margin="0,0,0,8">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDonHoanThanhTapped" CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="🧾" FontSize="22" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding TenGianHang}" FontAttributes="Bold" FontSize="13" />
                                    <Label FontSize="11.5" TextColor="{StaticResource TextGrey}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Đơn #" />
                                                <Span Text="{Binding Id}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="End">
                                    <Label Text="{Binding TrangThai, Converter={StaticResource TrangThaiToTextConverter}}"
                                           FontSize="11.5" HorizontalOptions="End" />
                                    <Label Text="{Binding TongTien, StringFormat='{0:N0}đ'}" FontSize="11.5" HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
