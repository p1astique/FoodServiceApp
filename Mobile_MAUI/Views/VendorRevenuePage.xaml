<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodServiceApp.Maui.Models"
             x:Class="FoodServiceApp.Maui.Views.VendorRevenuePage"
             Title="Doanh thu &amp; báo cáo">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- Tổng quan -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Frame Grid.Column="0" Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Doanh thu hôm nay" FontSize="12" TextColor="{StaticResource TextGrey}" />
                        <Label x:Name="LblDoanhThuHomNay" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource Primary}" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="1" Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Doanh thu 7 ngày qua" FontSize="12" TextColor="{StaticResource TextGrey}" />
                        <Label x:Name="LblDoanhThu7Ngay" FontAttributes="Bold" FontSize="18" TextColor="{StaticResource Primary}" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Frame Grid.Column="0" Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Tổng đơn hoàn thành" FontSize="12" TextColor="{StaticResource TextGrey}" />
                        <Label x:Name="LblTongDonHoanThanh" FontAttributes="Bold" FontSize="18" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="1" Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Giá trị đơn trung bình" FontSize="12" TextColor="{StaticResource TextGrey}" />
                        <Label x:Name="LblGiaTriTrungBinh" FontAttributes="Bold" FontSize="18" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Món bán chạy -->
            <Label Text="Món bán chạy" Style="{StaticResource TitleLabel}" FontSize="16" Margin="0,4,0,0" />
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout x:Name="KhungMonBanChay" Spacing="10" />
            </Frame>

            <!-- Lịch sử đơn hoàn thành -->
            <Label Text="Đơn hàng đã hoàn thành" Style="{StaticResource TitleLabel}" FontSize="16" Margin="0,4,0,0" />
            <Label x:Name="LblRong" Text="Chưa có đơn hàng hoàn thành nào." Style="{StaticResource SubtitleLabel}"
                   HorizontalOptions="Center" Margin="0,10,0,0" IsVisible="False" />

            <CollectionView x:Name="DsDonHoanThanh" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DonHang">
                        <Frame Style="{StaticResource CardFrame}" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding Id, StringFormat='Đơn #{0}'}" FontAttributes="Bold" FontSize="13" />
                                    <Label Text="{Binding NgayDat, StringFormat='{0:HH:mm dd/MM/yyyy}'}" FontSize="11" TextColor="{StaticResource TextGrey}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding TongTien, StringFormat='+{0:N0}đ'}"
                                       FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Success}" VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
