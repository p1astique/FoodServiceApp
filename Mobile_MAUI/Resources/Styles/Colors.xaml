<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Bảng màu thương hiệu: tím sáng (chủ đạo) + cam mango (nhấn) -->
    <Color x:Key="Primary">#7C3AED</Color>
    <Color x:Key="PrimaryLight">#A78BFA</Color>
    <Color x:Key="Accent">#FF9F1C</Color>
    <Color x:Key="Background">#F7F8F6</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="TextDark">#1E1E1E</Color>
    <Color x:Key="TextGrey">#7A7A7A</Color>
    <Color x:Key="Danger">#E0503B</Color>
    <Color x:Key="Success">#2E7D52</Color>
    <Color x:Key="Warning">#FFB74D</Color>
    <Color x:Key="BorderColor">#E6E6E6</Color>

</ResourceDictionary>
