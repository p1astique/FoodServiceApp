@model List<object>
@{ ViewData["Title"] = "Đánh giá"; }
<div class="topbar"><div><h2>Đánh giá khách hàng</h2><div class="text-muted">Điểm trung bình cửa hàng: ⭐ @(((double)ViewBag.DiemTrungBinh).ToString("0.0"))</div></div></div>
@if (!Model.Any()) { <div class="card"><div class="empty-state">Chưa có đánh giá.</div></div> }
else { <div class="card">@foreach (dynamic x in Model.OrderByDescending(x => ((dynamic)x).Ngay)) { <div class="review-row"><div><strong>@x.Ten</strong> · <span class="badge badge-primary">@x.Loai</span> · @x.SoSao ⭐</div><div class="text-muted" style="font-size:12px">Đơn #@x.MaDonHang · @x.Ngay.ToString("HH:mm dd/MM/yyyy")</div>@if (!string.IsNullOrWhiteSpace((string)x.NoiDung)) { <div class="mt-2">@x.NoiDung</div> }@if ((string)x.Loai == "Cửa hàng") { if (!string.IsNullOrWhiteSpace((string?)x.PhanHoiGianHang)) { <div class="mt-2"><strong>Phản hồi của gian hàng:</strong> @x.PhanHoiGianHang</div> } <form asp-action="PhanHoi" method="post" class="mt-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.MaDanhGia"/><input class="form-control" name="noiDung" maxlength="500" required placeholder="Nhập phản hồi đánh giá"/><button class="btn btn-outline btn-sm mt-2" type="submit">Lưu phản hồi</button></form> }</div> }</div> }
