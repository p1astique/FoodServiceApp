@model List<FoodServiceApp.Web.Models.Entities.DanhMuc>
@{ ViewData["Title"] = "Danh mục món ăn"; }
<div class="topbar"><div><h2>Danh mục món ăn</h2><div class="text-muted">Sắp xếp và chọn danh mục được hiển thị cho khách.</div></div></div>
<form asp-action="Save" method="post" class="card mb-3">
    <h3 style="margin-top:0">Thêm danh mục</h3>
    <div class="grid-3">
        <div class="form-group"><label>Tên danh mục</label><input name="TenDanhMuc" class="form-control" maxlength="100" required /></div>
        <div class="form-group"><label>Thứ tự</label><input name="ThuTuHienThi" type="number" value="@(Model.Count + 1)" min="0" max="999" class="form-control" /></div>
        <div class="form-group"><label>Hiển thị</label><label class="toggle-wrap"><input name="TrangThai" type="checkbox" value="true" checked /> Hiện với khách hàng</label></div>
    </div>
    <div class="form-group"><label>Mô tả</label><input name="MoTa" class="form-control" maxlength="255" /></div>
    <button class="btn btn-primary">+ Thêm danh mục</button>
</form>
@if (!Model.Any()) { <div class="card"><div class="empty-state">Chưa có danh mục.</div></div> }
@foreach (var item in Model)
{
    <div class="card mb-3">
        <form asp-action="Save" method="post">
            <input type="hidden" name="id" value="@item.MaDanhMuc" />
            <div class="grid-3">
                <div class="form-group"><label>Tên danh mục</label><input name="TenDanhMuc" value="@item.TenDanhMuc" class="form-control" maxlength="100" required /></div>
                <div class="form-group"><label>Thứ tự</label><input name="ThuTuHienThi" type="number" value="@item.ThuTuHienThi" min="0" max="999" class="form-control" /></div>
                <div class="form-group"><label>Trạng thái</label><span class="badge @(item.TrangThai ? "badge-success" : "badge-grey")">@(item.TrangThai ? "Đang hiển thị" : "Đang ẩn")</span><div class="text-muted mt-2">@item.MonAns.Count món</div></div>
            </div>
            <div class="form-group"><label>Mô tả</label><input name="MoTa" value="@item.MoTa" class="form-control" maxlength="255" /></div>
            <input type="hidden" name="TrangThai" value="@item.TrangThai.ToString().ToLowerInvariant()" />
            <button class="btn btn-primary">Lưu</button>
        </form>
        <div class="mt-2">
            <form asp-action="Toggle" method="post" style="display:inline"><input type="hidden" name="id" value="@item.MaDanhMuc" /><button class="btn btn-outline btn-sm">@(item.TrangThai ? "Ẩn" : "Hiện")</button></form>
            <form asp-action="Delete" method="post" style="display:inline" onsubmit="return confirm('Xóa danh mục này?');"><input type="hidden" name="id" value="@item.MaDanhMuc" /><button class="btn btn-danger btn-sm">Xóa</button></form>
        </div>
    </div>
}
