@model MonChiTietViewModel
@{
    ViewData["Title"] = Model.Mon.TenMon;
    Layout = "_CustomerLayout";
}

<div class="topbar">
    <h2>@Model.Mon.TenMon</h2>
    <a asp-action="ChiTiet" asp-route-id="@Model.GianHang.MaGianHang" class="btn btn-outline">← Về gian hàng</a>
</div>

<div class="grid-2">
    <div class="card dish-hero">
        @if (!string.IsNullOrEmpty(Model.Mon.HinhAnh))
        {
            <img src="@Model.Mon.HinhAnh" alt="@Model.Mon.TenMon" />
        }
        else
        {
            <div class="dish-hero-empty">🍲</div>
        }
    </div>

    <div class="card">
        <h3 style="margin-top:0;">@Model.Mon.TenMon</h3>
        <div class="dish-price">@Model.Mon.Gia.ToString("N0")đ</div>
        <p class="meta">
            Gian hàng:
            <a asp-action="ChiTiet" asp-route-id="@Model.GianHang.MaGianHang"><strong>@Model.GianHang.TenCuaHang</strong></a>
            &nbsp;·&nbsp; 📍 @Model.GianHang.DiaChi
        </p>
        <div class="rating-line">
            @if (Model.SoDanhGia > 0)
            {
                <span>⭐ @Model.DiemTrungBinh.ToString("0.0") (@Model.SoDanhGia đánh giá)</span>
            }
            else
            {
                <span class="text-muted">Món này chưa có đánh giá</span>
            }
        </div>

        <p style="margin-top:12px;">
            @(string.IsNullOrWhiteSpace(Model.Mon.MoTa) ? "Gian hàng chưa cập nhật mô tả cho món này." : Model.Mon.MoTa)
        </p>

        @if (Model.Mon.TinhTrang == "ConHang")
        {
            <form asp-action="ThemVaoGio" asp-route-maGianHang="@Model.GianHang.MaGianHang" method="post" style="margin-top:14px;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maMonAn" value="@Model.Mon.MaMonAn" />
                <input type="hidden" name="veTrangMon" value="true" />
                <div class="grid-3">
                @if (!string.IsNullOrWhiteSpace(Model.Mon.KichCo)) { <div class="form-group"><label>Kích cỡ</label><select name="kichCo" class="form-control">@foreach (var x in Model.Mon.KichCo.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)) { <option value="@x">@x</option> }</select></div> }
                @if (!string.IsNullOrWhiteSpace(Model.Mon.Topping)) { <div class="form-group"><label>Topping</label><select name="topping" class="form-control"><option value="">Không chọn</option>@foreach (var x in Model.Mon.Topping.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)) { <option value="@x">@x</option> }</select></div> }
                @if (!string.IsNullOrWhiteSpace(Model.Mon.MucCay)) { <div class="form-group"><label>Mức cay</label><select name="mucCay" class="form-control">@foreach (var x in Model.Mon.MucCay.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)) { <option value="@x">@x</option> }</select></div> }
                </div>
                <div class="form-group"><label>Ghi chú riêng cho món</label><input name="ghiChuMon" maxlength="150" class="form-control" placeholder="Ví dụ: không hành" /></div>
                <div style="display:flex;gap:10px;align-items:center"><label>Số lượng</label><input type="number" name="soLuong" value="1" min="1" max="20" class="form-control" style="width:90px;" /><button type="submit" class="btn btn-primary">🛒 Thêm vào giỏ hàng</button></div>
            </form>
        }
        else
        {
            <span class="badge badge-grey" style="margin-top:14px;">Hết hàng</span>
        }
    </div>
</div>

<div class="card" style="margin-top:16px;">
    <h3 style="margin-top:0;">Đánh giá về món</h3>
    @if (!Model.DanhGias.Any())
    {
        <div class="empty-state">Chưa có đánh giá nào. Hãy đặt món và là người đầu tiên đánh giá!</div>
    }
    else
    {
        @foreach (var dg in Model.DanhGias)
        {
            <div class="review-row">
                <div><strong>@dg.TenKhach</strong> &nbsp; @(new string('⭐', dg.SoSao)) <span class="text-muted" style="font-size:12px;">· @dg.Ngay.ToString("dd/MM/yyyy")</span></div>
                @if (!string.IsNullOrWhiteSpace(dg.NoiDung))
                {
                    <div style="font-size:13.5px; margin-top:2px;">@dg.NoiDung</div>
                }
            </div>
        }
    }
</div>
