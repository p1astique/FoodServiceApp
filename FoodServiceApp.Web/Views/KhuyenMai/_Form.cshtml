@model KhuyenMaiFormViewModel

<div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

<div class="form-group">
    <label asp-for="MaCode">Mã khuyến mãi</label>
    <input asp-for="MaCode" class="form-control" placeholder="vd: GIAM20" style="text-transform:uppercase;" />
    <span asp-validation-for="MaCode" class="field-validation-error"></span>
</div>

<div class="form-group">
    <label asp-for="MoTa">Mô tả</label>
    <textarea asp-for="MoTa" class="form-control" placeholder="vd: Giảm 20% cho đơn từ 50.000đ"></textarea>
</div>

<div class="grid-2">
    <div class="form-group">
        <label asp-for="LoaiGiam">Loại giảm</label>
        <select asp-for="LoaiGiam" class="form-control">
            <option value="PhanTram">Giảm theo %</option>
            <option value="SoTien">Giảm số tiền cố định</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="GiaTriGiam">Giá trị giảm</label>
        <input asp-for="GiaTriGiam" type="number" step="1" class="form-control" placeholder="vd: 20" />
    </div>
</div>

<div class="form-group"><label><input asp-for="GiamPhiVanChuyen" /> Giảm phí vận chuyển thay cho giảm tiền món</label></div>
<div class="grid-3">
    <div class="form-group"><label asp-for="GiaTriDonToiThieu">Đơn tối thiểu (đ)</label><input asp-for="GiaTriDonToiThieu" type="number" min="0" class="form-control" /></div>
    <div class="form-group"><label asp-for="SoLuongToiDa">Giới hạn lượt dùng</label><input asp-for="SoLuongToiDa" type="number" min="1" class="form-control" placeholder="Không giới hạn" /></div>
    <div class="form-group"><label asp-for="GiamPhiVanChuyenToiDa">Giảm phí ship tối đa</label><input asp-for="GiamPhiVanChuyenToiDa" type="number" min="0" class="form-control" placeholder="Trống = miễn toàn bộ" /></div>
</div>
<div class="form-group"><label><input asp-for="MoiKhachMotLan" /> Mỗi khách chỉ được sử dụng một lần</label></div>

@if (Model.DanhSachGianHang.Any())
{
    <div class="form-group"><label asp-for="MaGianHangApDung">Gian hàng áp dụng</label><select asp-for="MaGianHangApDung" class="form-control" asp-items="@(new SelectList(Model.DanhSachGianHang, "MaGianHang", "TenCuaHang"))"><option value="">— Tất cả gian hàng —</option></select></div>
}

<div class="form-group"><label asp-for="MaDanhMuc">Danh mục áp dụng</label><select asp-for="MaDanhMuc" class="form-control" asp-items="@(new SelectList(Model.DanhSachDanhMuc, "MaDanhMuc", "TenDanhMuc"))"><option value="">— Không giới hạn danh mục —</option></select></div>

<div class="form-group">
    <label asp-for="MaMonAn">Áp dụng cho món</label>
    <select asp-for="MaMonAn" class="form-control"
            asp-items="@(new SelectList(Model.DanhSachMon, "MaMonAn", "TenMon", Model.MaMonAn))">
        <option value="">— Không giới hạn món —</option>
    </select>
    <span asp-validation-for="MaMonAn" class="field-validation-error"></span>
</div>

<div class="form-group">
    <label asp-for="DieuKienApDung">Điều kiện áp dụng</label>
    <input asp-for="DieuKienApDung" class="form-control" placeholder="vd: Đơn tối thiểu 50.000đ" />
</div>

<div class="grid-2">
    <div class="form-group">
        <label asp-for="NgayBatDau">Ngày bắt đầu</label>
        <input asp-for="NgayBatDau" type="date" class="form-control" />
        <span asp-validation-for="NgayBatDau" class="field-validation-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="NgayKetThuc">Ngày kết thúc</label>
        <input asp-for="NgayKetThuc" type="date" class="form-control" />
        <span asp-validation-for="NgayKetThuc" class="field-validation-error"></span>
    </div>
</div>

<div class="form-group">
    <label style="display:flex; align-items:center; gap:8px;">
        <input asp-for="TrangThai" type="checkbox" style="width:auto;" />
        Kích hoạt ngay
    </label>
</div>
