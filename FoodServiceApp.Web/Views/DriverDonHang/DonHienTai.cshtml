@model DonHang
@{
    ViewData["Title"] = "Chuyến giao hiện tại";
    Layout = "_DriverLayout";
}

<div class="topbar">
    <h2>Chuyến giao hiện tại</h2>
</div>

@if (Model == null)
{
    <div class="card">
        <div class="empty-state">Bạn không có chuyến giao nào đang thực hiện.</div>
        <div style="text-align:center;"><a asp-action="ChoNhan" class="btn btn-primary">Xem đơn chờ nhận</a></div>
    </div>
}
else
{
    var trangThaiGiao = Model.GiaoHang?.TrangThai ?? "DaNhan";

    <div class="card mb-3">
        <h3 style="margin-top:0;">Đơn #@Model.MaDonHang</h3>
        <p><strong>Lấy hàng tại:</strong> @Model.GianHang?.TenCuaHang</p>
        <p style="color:var(--text-grey); margin-top:-8px;">@Model.GianHang?.DiaChi — @Model.GianHang?.SDT</p>
        <p><strong>Giao đến:</strong> @Model.DiaChiGiaoHang</p>
        <p><strong>Món:</strong> @string.Join(", ", Model.ChiTiets.Select(c => $"{c.MonAn?.TenMon} x{c.SoLuong}"))</p>
        <p><strong>Tổng tiền thu hộ (nếu COD):</strong> @Model.TongTien.ToString("N0")đ</p>
        <p><strong>Bạn nhận:</strong> <span style="color:var(--success); font-weight:700;">@Model.PhiGiaoHang.ToString("N0")đ</span></p>
        @if (!string.IsNullOrEmpty(Model.GhiChu))
        {
            <p><strong>Ghi chú:</strong> @Model.GhiChu</p>
        }

        @{
            // Chỉ cần "destination", Google Maps sẽ tự lấy vị trí hiện tại của tài xế (GPS thiết bị)
            // làm điểm xuất phát khi mở trên điện thoại — không cần biết toạ độ tài xế đang ở đâu.
            var diaChiDich = trangThaiGiao == "DaNhan" ? Model.GianHang?.DiaChi : Model.DiaChiGiaoHang;
            var nhanNutChiDuong = trangThaiGiao == "DaNhan" ? "🗺️ Chỉ đường đến gian hàng" : "🗺️ Chỉ đường đến khách hàng";
        }
        @if (!string.IsNullOrEmpty(diaChiDich))
        {
            <a class="btn btn-outline" style="margin-top:6px;"
               href="https://www.google.com/maps/dir/?api=1&destination=@Uri.EscapeDataString(diaChiDich)"
               target="_blank" rel="noopener">@nhanNutChiDuong</a>
        }
    </div>

    <div class="card">
        <h3 style="margin-top:0;">Cập nhật trạng thái</h3>

        @if (trangThaiGiao == "DaNhan")
        {
            <p class="text-muted">Bạn đã nhận đơn — bấm bắt đầu khi lấy hàng xong và lên đường giao.</p>
            <form asp-action="BatDauGiao" asp-route-id="@Model.MaDonHang" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">Bắt đầu giao hàng</button>
            </form>
        }
        else if (trangThaiGiao == "DangGiao")
        {
            <p class="text-muted">Đang trên đường giao. Cập nhật kết quả khi đến nơi:</p>
            <div style="display:flex; gap:10px;">
                <form asp-action="HoanThanh" asp-route-id="@Model.MaDonHang" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary"
                            onclick="return confirm('Xác nhận đã giao thành công đơn #@Model.MaDonHang?')">✓ Giao thành công</button>
                </form>
                <button type="button" class="btn btn-danger" onclick="document.getElementById('formThatBai').style.display='block'">
                    ✕ Giao thất bại
                </button>
            </div>

            <form id="formThatBai" asp-action="GiaoThatBai" asp-route-id="@Model.MaDonHang" method="post" style="display:none; margin-top:14px;">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>Lý do giao thất bại</label>
                    <input type="text" name="lyDo" class="form-control" placeholder="vd: Khách không nghe máy" required />
                </div>
                <button type="submit" class="btn btn-danger">Xác nhận giao thất bại</button>
            </form>
        }
    </div>
}
